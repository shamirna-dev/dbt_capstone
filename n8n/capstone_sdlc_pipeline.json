{
  "name": "Capstone - AI Data SDLC Pipeline",
  "meta": {
    "description": "Requirements to deployed, tested pipeline. n8n owns the human approval gate and notifications; Snowflake owns the work."
  },
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-720, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "sfHost",
              "value": "igtstwc-td17035.snowflakecomputing.com",
              "type": "string"
            },
            {
              "id": "cfg-2",
              "name": "reqId",
              "value": "REQ-101",
              "type": "string"
            },
            {
              "id": "cfg-3",
              "name": "approver",
              "value": "shamirna.antony",
              "type": "string"
            },
            {
              "id": "cfg-4",
              "name": "targetLag",
              "value": "60 minutes",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-500, 300],
      "notes": "Change reqId to run a different intake item. REQ-102 is the Workday request and is expected to be refused by governance."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $json.sfHost }}/api/v2/statements",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Snowflake-Authorization-Token-Type",
              "value": "PROGRAMMATIC_ACCESS_TOKEN"
            },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ statement: \"CALL CAPSTONE_AI_DLC.AGENTS.STAGE_REQUIREMENTS('\" + $json.reqId + \"','N8N')\", timeout: 600, database: 'CAPSTONE_AI_DLC', schema: 'AGENTS', warehouse: 'COMPUTE_WH', role: 'ACCOUNTADMIN' }) }}",
        "options": { "response": { "response": { "neverError": false } } }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Stage 1 - Requirements to Stories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-280, 300]
    },
    {
      "parameters": {
        "jsCode": "// The Snowflake SQL API returns scalar/object results as a JSON string in data[0][0].\nconst body = $input.first().json;\nconst raw = body?.data?.[0]?.[0];\nif (!raw) {\n  throw new Error('No result returned by Snowflake. Response: ' + JSON.stringify(body).slice(0, 500));\n}\nconst result = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst cfg = $('Config').first().json;\nreturn [{ json: { ...result, sfHost: cfg.sfHost, approver: cfg.approver, targetLag: cfg.targetLag, reqId: cfg.reqId } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Parse Stage 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-60, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "gc-1",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.status }}",
              "rightValue": "GOVERNANCE_CONFLICT"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Blocked by Governance?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [160, 300]
    },
    {
      "parameters": {
        "jsCode": "// Governance refused the request. This is a successful control firing, not an\n// error - so the workflow reports and stops cleanly rather than failing.\nconst j = $input.first().json;\nconst reason = j?.conflict?.reason ?? 'not stated';\nconst cites = (j?.conflict?.citations ?? []).join(', ');\nreturn [{ json: {\n  outcome: 'HALTED_BY_GOVERNANCE',\n  requirement: j.reqId,\n  message: 'Request refused before any code was written. Reason: ' + reason,\n  citations: cites\n}}];"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Report Governance Halt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 140]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $json.sfHost }}/api/v2/statements",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Snowflake-Authorization-Token-Type",
              "value": "PROGRAMMATIC_ACCESS_TOKEN"
            },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ statement: \"CALL CAPSTONE_AI_DLC.AGENTS.STAGE_BUILD('N8N')\", timeout: 900, database: 'CAPSTONE_AI_DLC', schema: 'AGENTS', warehouse: 'COMPUTE_WH', role: 'ACCOUNTADMIN' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Stage 2 - Scaffold ETL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [380, 420]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst raw = body?.data?.[0]?.[0];\nconst result = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst cfg = $('Config').first().json;\nconst lines = (result.detail ?? []).map(d => `  ${d.source}: ${d.status}${d.compile ? ' (compile ' + d.compile + ')' : ''}`);\nreturn [{ json: {\n  ...result,\n  ...cfg,\n  reviewSummary: [\n    `Scaffolded: ${result.scaffolded}`,\n    `Refused by governance: ${result.blocked_by_governance}`,\n    `Failed: ${result.failed}`,\n    'Per source:',\n    ...lines\n  ].join('\\n')\n}}];"
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Parse Stage 2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 420]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "HUMAN APPROVAL GATE",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "webhookId": "capstone-approval-gate",
      "position": [820, 420],
      "notes": "This is the reason n8n is in the architecture. Generated code sits at status DRAFT in ARTIFACTS.GENERATED_CODE until a reviewer resumes this node. Nothing is materialised before that. Review the scaffolded SQL, then call the resume URL to proceed."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $('Parse Stage 2').first().json.sfHost }}/api/v2/statements",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Snowflake-Authorization-Token-Type",
              "value": "PROGRAMMATIC_ACCESS_TOKEN"
            },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ statement: \"CALL CAPSTONE_AI_DLC.AGENTS.STAGE_DEPLOY('\" + $('Parse Stage 2').first().json.approver + \"','\" + $('Parse Stage 2').first().json.targetLag + \"')\", timeout: 900, database: 'CAPSTONE_AI_DLC', schema: 'AGENTS', warehouse: 'COMPUTE_WH', role: 'ACCOUNTADMIN' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Stage 3 - Approve and Deploy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $('Parse Stage 2').first().json.sfHost }}/api/v2/statements",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Snowflake-Authorization-Token-Type",
              "value": "PROGRAMMATIC_ACCESS_TOKEN"
            },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ statement: \"CALL CAPSTONE_AI_DLC.AGENTS.STAGE_QA('N8N', TRUE)\", timeout: 900, database: 'CAPSTONE_AI_DLC', schema: 'AGENTS', warehouse: 'COMPUTE_WH', role: 'ACCOUNTADMIN' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Stage 4 - Generate and Run QA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 420]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst raw = body?.data?.[0]?.[0];\nconst result = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst cfg = $('Config').first().json;\nreturn [{ json: { ...result, ...cfg } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Parse Stage 4",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1480, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "qa-1",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.gate }}",
              "rightValue": "PASS"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "QA Gate Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1700, 420]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nreturn [{ json: {\n  outcome: 'RELEASED',\n  message: 'Pipeline deployed and all applicable data quality tests passed.',\n  tests_passed: j?.execution?.passed ?? null,\n  tests_failed: j?.execution?.failed ?? null\n}}];"
      },
      "id": "a1000000-0000-4000-8000-000000000014",
      "name": "Report Release",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $('Config').first().json.sfHost }}/api/v2/statements",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Snowflake-Authorization-Token-Type",
              "value": "PROGRAMMATIC_ACCESS_TOKEN"
            },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ statement: \"CALL CAPSTONE_AI_DLC.AGENTS.STAGE_TRIAGE('CLEAN','N8N')\", timeout: 600, database: 'CAPSTONE_AI_DLC', schema: 'AGENTS', warehouse: 'COMPUTE_WH', role: 'ACCOUNTADMIN' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000015",
      "name": "Stage 5 - Triage Failures",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 560]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst raw = body?.data?.[0]?.[0];\nconst result = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst d = result?.defect ?? {};\nreturn [{ json: {\n  outcome: 'BLOCKED_BY_QA',\n  message: 'Release blocked. A defect has been triaged and raised in ARTIFACTS.DEFECTS.',\n  defect_id: d.defect_id ?? null,\n  category: d.category ?? null,\n  severity: d.severity ?? null,\n  confidence: d.confidence ?? null\n}}];"
      },
      "id": "a1000000-0000-4000-8000-000000000016",
      "name": "Report Blocked Release",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2140, 560]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Stage 1 - Requirements to Stories", "type": "main", "index": 0 }]] },
    "Stage 1 - Requirements to Stories": { "main": [[{ "node": "Parse Stage 1", "type": "main", "index": 0 }]] },
    "Parse Stage 1": { "main": [[{ "node": "Blocked by Governance?", "type": "main", "index": 0 }]] },
    "Blocked by Governance?": {
      "main": [
        [{ "node": "Report Governance Halt", "type": "main", "index": 0 }],
        [{ "node": "Stage 2 - Scaffold ETL", "type": "main", "index": 0 }]
      ]
    },
    "Stage 2 - Scaffold ETL": { "main": [[{ "node": "Parse Stage 2", "type": "main", "index": 0 }]] },
    "Parse Stage 2": { "main": [[{ "node": "HUMAN APPROVAL GATE", "type": "main", "index": 0 }]] },
    "HUMAN APPROVAL GATE": { "main": [[{ "node": "Stage 3 - Approve and Deploy", "type": "main", "index": 0 }]] },
    "Stage 3 - Approve and Deploy": { "main": [[{ "node": "Stage 4 - Generate and Run QA", "type": "main", "index": 0 }]] },
    "Stage 4 - Generate and Run QA": { "main": [[{ "node": "Parse Stage 4", "type": "main", "index": 0 }]] },
    "Parse Stage 4": { "main": [[{ "node": "QA Gate Passed?", "type": "main", "index": 0 }]] },
    "QA Gate Passed?": {
      "main": [
        [{ "node": "Report Release", "type": "main", "index": 0 }],
        [{ "node": "Stage 5 - Triage Failures", "type": "main", "index": 0 }]
      ]
    },
    "Stage 5 - Triage Failures": { "main": [[{ "node": "Report Blocked Release", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
